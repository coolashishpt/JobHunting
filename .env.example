# Copy to .env and fill values for production
DJ_SECRET_KEY=replace-me-with-a-secure-key
DJ_DEBUG=False
DJ_ALLOWED_HOSTS=example.com,www.example.com
# Email (optional - leave blank to use console backend in development)
DJ_EMAIL_HOST=
DJ_EMAIL_PORT=
DJ_EMAIL_HOST_USER=
DJ_EMAIL_HOST_PASSWORD=
DJ_EMAIL_USE_TLS=False
DJ_EMAIL_USE_SSL=False
DJ_DEFAULT_FROM_EMAIL=noreply@example.com

# Celery / Redis broker (optional for production async tasks)
DJ_CELERY_BROKER_URL=redis://localhost:6379/0
DJ_CELERY_RESULT_BACKEND=redis://localhost:6379/0
